# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# AVRX.IN PRODUCTION EMAIL SYSTEM CONFIG
# ==========================================

# 1. Admin Destination Email (Where inquiries are sent)
ADMIN_EMAIL=avrx.india@gmail.com

# 2. Sender Identity (Appears in client auto-reply)
EMAIL_FROM=contact@avrx.in
EMAIL_FROM_NAME="AVRX Digital & Financial Solution"

# 3. Transactional Email API (Recommended for Vercel Serverless / Resend)
# Create a free API key at https://resend.com and add domain 'avrx.in'
RESEND_API_KEY=
EMAIL_API_KEY=

# 4. Alternative: SMTP Credentials (Hostinger / cPanel / Gmail App Password)
SMTP_HOST=mail.avrx.in
SMTP_PORT=465
SMTP_USER=contact@avrx.in
SMTP_PASS=
SMTP_SECURE=true


